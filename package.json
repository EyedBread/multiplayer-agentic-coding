{
  "name": "multiplayer-agentic-coding",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "runner": "tsx runner/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write src server shared runner tests README.md index.html vite.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.288",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@openai/codex": "0.160.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.1.0"
  }
}
